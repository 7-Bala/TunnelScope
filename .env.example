# Copy this file to .env (git-ignored, never committed) and fill in your own values.
# ./start.sh loads .env automatically before starting the engine.
#
# DEC-038 / DEC-040 (owner overrides of the offline-only rule). Reading captures and producing findings, verdicts
# and scores NEVER uses the network. Only optional extras do, and ALL of them are off unless you set:
# TUNNELSCOPE_NETWORK=on
# An air-gapped install leaves it off: drafting uses the local model, threat intel uses an offline bundle.

# ---- remediation drafting (who writes a candidate fix; every draft is re-verified by the same checks) ----
# "local" (on-device), "cloud" (Gemini only) or "chain" (DEC-040: cloud models in order, then local).
# Unset: "chain" when a cloud API key below is set, else "local" (DEC-064).
# TUNNELSCOPE_GENERATOR_BACKEND=chain
# DEC-064: AI drafting is ON by default whenever a cloud API key is set and the network is not off (never in the
# public demo). TUNNELSCOPE_GENERATOR=0 turns it off; =1 forces it on, the on-device model included.
# TUNNELSCOPE_GENERATOR=0

# Gemini keys, one per JOB (never rotated to get round a quota: limits are per project, Google APIs Terms 2(d)).
# TUNNELSCOPE_KEY_PURPOSE picks TUNNELSCOPE_GEMINI_API_KEY_<PURPOSE>; without it the plain key is used.
# TUNNELSCOPE_GEMINI_API_KEY=              # experiments (EXP-18b)
# TUNNELSCOPE_GEMINI_API_KEY_DEV=          # day-to-day development
# TUNNELSCOPE_GEMINI_API_KEY_DEMO=         # live demos
# TUNNELSCOPE_KEY_PURPOSE=dev
# Free-tier Gemini: Google may use prompts to improve its products and human reviewers may read them. Do not
# send client configurations through a free key; enable billing (paid tier does not) or use the Groq key below.
# TUNNELSCOPE_GEMINI_MODEL=gemini-3.1-flash-lite   # DEC-041 default (EXP-18b)

# Groq (hosted open-weight models; free tier does not train on inputs or outputs). https://console.groq.com
# TUNNELSCOPE_GROQ_API_KEY=
# TUNNELSCOPE_GROQ_MODEL=openai/gpt-oss-120b

# Optional explicit order; default (DEC-041): "groq:openai/gpt-oss-120b,gemini:gemini-3.1-flash-lite,gemini:gemini-3.7-flash,local"
# TUNNELSCOPE_GENERATOR_CHAIN=

# ---- threat intelligence (T-130): NVD, EUVD, CISA KEV, MITRE ATT&CK/CAPEC ----
# Optional NVD key (5 -> 50 requests per 30 s). https://nvd.nist.gov/developers/request-an-api-key
# TUNNELSCOPE_NVD_API_KEY=
# Where lookups are cached; on an air-gapped machine point this at a bundle made by `tunnelscope intel-bundle`
# TUNNELSCOPE_INTEL_DIR=~/.tunnelscope-intel
